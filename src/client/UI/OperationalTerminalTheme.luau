--!strict

-- Shared visual language for operational terminals. MDT and Force Control have
-- different workflows, but officers should recognise them as the same secure
-- system immediately rather than relearning colours and hierarchy at a desk.
return {
	Surface = Color3.fromRGB(6, 16, 28),
	Raised = Color3.fromRGB(14, 32, 50),
	Border = Color3.fromRGB(48, 91, 121),
	Text = Color3.fromRGB(244, 247, 252),
	Muted = Color3.fromRGB(151, 163, 184),
	Accent = Color3.fromRGB(27, 137, 191),
	Classification = Color3.fromRGB(241, 176, 47),
	Secure = Color3.fromRGB(89, 215, 144),
	Immediate = Color3.fromRGB(244, 82, 92),
}
