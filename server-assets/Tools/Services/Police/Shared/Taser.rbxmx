		<Item class="Script" referent="RBX3A8F95D66AB642AFA6DC767B9B9C2A0B">
			<Properties>
				<string name="Name">RoleplayOSTaserServer</string>
				<string name="Source">local Players = game:GetService(&quot;Players&quot;)

local tool = script.Parent
local fireRemote = tool:WaitForChild(&quot;FireTaser&quot;)
local reloadRemote = tool:WaitForChild(&quot;Reload&quot;)
local flashlightRemote = tool:WaitForChild(&quot;Flashlight&quot;)
local laserRemote = tool:WaitForChild(&quot;Laser&quot;)
local updateRemote = tool:WaitForChild(&quot;UpdateAmmo&quot;)
local roundsValue = tool:WaitForChild(&quot;Rounds&quot;)

local MAX_RANGE = 25
local FIRE_COOLDOWN = 1.25
local STUN_SECONDS = 5
local lastFire = 0
local reloading = false
local stunTokens = setmetatable({}, { __mode = &quot;k&quot; })

local function owner(): Player?
&#9;local character = tool.Parent
&#9;if not character or not character:IsA(&quot;Model&quot;) then
&#9;&#9;return nil
&#9;end
&#9;return Players:GetPlayerFromCharacter(character)
end

local function equippedBy(player: Player): boolean
&#9;return owner() == player and tool:IsDescendantOf(player.Character)
&#9;&#9;and table.find({ &quot;PoliceResponse&quot;, &quot;PoliceFrontline&quot;, &quot;ArmedResponse&quot;, &quot;RoadsPolicing&quot; }, tool:GetAttribute(&quot;RoleplayOSLoadoutId&quot;)) ~= nil
end

local function finiteVector3(value): boolean
&#9;return typeof(value) == &quot;Vector3&quot;
&#9;&#9;and value.X == value.X and value.Y == value.Y and value.Z == value.Z
&#9;&#9;and math.abs(value.X) &lt; 1e6 and math.abs(value.Y) &lt; 1e6 and math.abs(value.Z) &lt; 1e6
end

local function setVisual(remotePartName: string, enabled: boolean)
&#9;local part = tool:FindFirstChild(remotePartName)
&#9;if not part or not part:IsA(&quot;BasePart&quot;) then
&#9;&#9;return
&#9;end
&#9;if remotePartName == &quot;LaserPart&quot; then
&#9;&#9;part.Transparency = if enabled then 0 else 1
&#9;else
&#9;&#9;local light = part:FindFirstChildWhichIsA(&quot;Light&quot;)
&#9;&#9;if light then
&#9;&#9;&#9;light.Enabled = enabled
&#9;&#9;end
&#9;end
end

local function stun(humanoid: Humanoid)
&#9;local token = {}
&#9;stunTokens[humanoid] = token
&#9;local previousWalkSpeed = humanoid.WalkSpeed
&#9;local previousJumpPower = humanoid.JumpPower
&#9;local previousJumpHeight = humanoid.JumpHeight
&#9;local previousAutoRotate = humanoid.AutoRotate
&#9;humanoid:UnequipTools()
&#9;humanoid.WalkSpeed = 0
&#9;humanoid.JumpPower = 0
&#9;humanoid.JumpHeight = 0
&#9;humanoid.AutoRotate = false
&#9;task.delay(STUN_SECONDS, function()
&#9;&#9;if stunTokens[humanoid] ~= token or not humanoid.Parent then
&#9;&#9;&#9;return
&#9;&#9;end
&#9;&#9;stunTokens[humanoid] = nil
&#9;&#9;humanoid.WalkSpeed = previousWalkSpeed
&#9;&#9;humanoid.JumpPower = previousJumpPower
&#9;&#9;humanoid.JumpHeight = previousJumpHeight
&#9;&#9;humanoid.AutoRotate = previousAutoRotate
&#9;end)
end

fireRemote.OnServerEvent:Connect(function(player: Player, targetPosition)
&#9;if not equippedBy(player) or not finiteVector3(targetPosition) or reloading then
&#9;&#9;return
&#9;end
&#9;local now = os.clock()
&#9;if now - lastFire &lt; FIRE_COOLDOWN or roundsValue.Value &lt;= 0 then
&#9;&#9;return
&#9;end
&#9;local firePosition = tool:FindFirstChild(&quot;FirePosition&quot;)
&#9;if not firePosition or not firePosition:IsA(&quot;BasePart&quot;) then
&#9;&#9;return
&#9;end
&#9;local delta = targetPosition - firePosition.Position
&#9;if delta.Magnitude &lt; 0.1 then
&#9;&#9;return
&#9;end
&#9;lastFire = now
&#9;roundsValue.Value -= 1
&#9;updateRemote:FireClient(player, roundsValue.Value)
&#9;local sound = tool:FindFirstChild(&quot;TaserSound&quot;, true)
&#9;if sound and sound:IsA(&quot;Sound&quot;) then
&#9;&#9;sound:Play()
&#9;end
&#9;local parameters = RaycastParams.new()
&#9;parameters.FilterType = Enum.RaycastFilterType.Exclude
&#9;parameters.FilterDescendantsInstances = { player.Character, tool }
&#9;local result = workspace:Raycast(firePosition.Position, delta.Unit * math.min(delta.Magnitude, MAX_RANGE), parameters)
&#9;if not result then
&#9;&#9;return
&#9;end
&#9;local character = result.Instance:FindFirstAncestorOfClass(&quot;Model&quot;)
&#9;local humanoid = character and character:FindFirstChildOfClass(&quot;Humanoid&quot;)
&#9;if not humanoid or humanoid.Health &lt;= 0 or Players:GetPlayerFromCharacter(character) == player then
&#9;&#9;return
&#9;end
&#9;stun(humanoid)
end)

reloadRemote.OnServerEvent:Connect(function(player: Player)
&#9;if not equippedBy(player) or reloading or roundsValue.Value &gt;= 2 then
&#9;&#9;return
&#9;end
&#9;reloading = true
&#9;local cartridge = tool:FindFirstChild(&quot;Cartridge&quot;)
&#9;if cartridge and cartridge:IsA(&quot;BasePart&quot;) then
&#9;&#9;cartridge.Transparency = 1
&#9;end
&#9;task.delay(0.8, function()
&#9;&#9;if cartridge and cartridge.Parent then
&#9;&#9;&#9;cartridge.Transparency = 0
&#9;&#9;end
&#9;&#9;roundsValue.Value = 2
&#9;&#9;reloading = false
&#9;&#9;if player.Parent then
&#9;&#9;&#9;updateRemote:FireClient(player, 2)
&#9;&#9;end
&#9;end)
end)

flashlightRemote.OnServerEvent:Connect(function(player: Player, enabled)
&#9;if equippedBy(player) and type(enabled) == &quot;boolean&quot; then
&#9;&#9;setVisual(&quot;FlashlightPart&quot;, enabled)
&#9;end
end)

laserRemote.OnServerEvent:Connect(function(player: Player, enabled)
&#9;if equippedBy(player) and type(enabled) == &quot;boolean&quot; then
&#9;&#9;setVisual(&quot;LaserPart&quot;, enabled)
&#9;end
end)

</string>
			</Properties>
		</Item>
		<Item class="LocalScript" referent="RBX434CAC901CDF40BCA2FBCBAF0463D1D4">
			<Properties>
				<string name="Name">RoleplayOSTaserClient</string>
				<string name="Source">local ContextActionService = game:GetService(&quot;ContextActionService&quot;)
local Players = game:GetService(&quot;Players&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)

local player = Players.LocalPlayer
local tool = script.Parent
local fireRemote = tool:WaitForChild(&quot;FireTaser&quot;)
local reloadRemote = tool:WaitForChild(&quot;Reload&quot;)
local flashlightRemote = tool:WaitForChild(&quot;Flashlight&quot;)
local laserRemote = tool:WaitForChild(&quot;Laser&quot;)
local updateRemote = tool:WaitForChild(&quot;UpdateAmmo&quot;)
local roundsValue = tool:WaitForChild(&quot;Rounds&quot;)
local mouse = player:GetMouse()
local screen
local safety = false
local flashlight = false
local laser = false
local tracks = {}

local function stopAnimations()
&#9;for _, track in tracks do
&#9;&#9;track:Stop(0.15)
&#9;&#9;track:Destroy()
&#9;end
&#9;table.clear(tracks)
end

local function loadAnimations()
&#9;stopAnimations()
&#9;local character = player.Character
&#9;local humanoid = character and character:FindFirstChildOfClass(&quot;Humanoid&quot;)
&#9;if not humanoid then return end
&#9;local animator = humanoid:FindFirstChildOfClass(&quot;Animator&quot;) or Instance.new(&quot;Animator&quot;, humanoid)
&#9;local folder = tool:FindFirstChild(&quot;Animations&quot;)
&#9;if not folder then return end
&#9;for _, name in { &quot;IdleAnimation&quot;, &quot;ShootAnimation&quot;, &quot;ReloadAnimation&quot; } do
&#9;&#9;local animation = folder:FindFirstChild(name)
&#9;&#9;if animation and animation:IsA(&quot;Animation&quot;) then
&#9;&#9;&#9;local ok, track = pcall(animator.LoadAnimation, animator, animation)
&#9;&#9;&#9;if ok then
&#9;&#9;&#9;&#9;track.Priority = Enum.AnimationPriority.Action
&#9;&#9;&#9;&#9;track.Looped = name == &quot;IdleAnimation&quot;
&#9;&#9;&#9;&#9;tracks[name] = track
&#9;&#9;&#9;end
&#9;&#9;end
&#9;end
&#9;if tracks.IdleAnimation then tracks.IdleAnimation:Play(0.18) end
end

local function playAnimation(name: string)
&#9;local track = tracks[name]
&#9;if track then track:Play(0.08) end
end

local function updateAmmo(rounds: number)
&#9;if screen then
&#9;&#9;local label = screen:FindFirstChild(&quot;ammo_input&quot;, true)
&#9;&#9;if label and label:IsA(&quot;TextLabel&quot;) then
&#9;&#9;&#9;label.Text = string.format(&quot;%d/2&quot;, rounds)
&#9;&#9;end
&#9;end
end

local function toggleIndicator(name: string, enabled: boolean)
&#9;if not screen then return end
&#9;local object = screen:FindFirstChild(name, true)
&#9;if object and object:IsA(&quot;ImageButton&quot;) then
&#9;&#9;object.ImageColor3 = if enabled then Color3.fromRGB(235, 245, 255) else Color3.fromRGB(75, 75, 75)
&#9;end
end

local function action(name: string, state: Enum.UserInputState)
&#9;if state ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
&#9;if name == &quot;RoleplayOSTaserReload&quot; then reloadRemote:FireServer(); playAnimation(&quot;ReloadAnimation&quot;)
&#9;elseif name == &quot;RoleplayOSTaserSafety&quot; then safety = not safety; toggleIndicator(&quot;safety&quot;, safety)
&#9;elseif name == &quot;RoleplayOSTaserLight&quot; then flashlight = not flashlight; flashlightRemote:FireServer(flashlight); toggleIndicator(&quot;flash&quot;, flashlight)
&#9;elseif name == &quot;RoleplayOSTaserLaser&quot; then laser = not laser; laserRemote:FireServer(laser); toggleIndicator(&quot;laser&quot;, laser) end
&#9;return Enum.ContextActionResult.Sink
end

tool.Activated:Connect(function()
&#9;if not safety then fireRemote:FireServer(mouse.Hit.Position); playAnimation(&quot;ShootAnimation&quot;) end
end)

tool.Equipped:Connect(function()
&#9;loadAnimations()
&#9;local template = tool:FindFirstChild(&quot;X2Appearance&quot;)
&#9;if template then
&#9;&#9;screen = template:Clone()
&#9;&#9;screen.ResetOnSpawn = true
&#9;&#9;screen.Parent = player:WaitForChild(&quot;PlayerGui&quot;)
&#9;&#9;updateAmmo(roundsValue.Value)
&#9;end
&#9;ContextActionService:BindAction(&quot;RoleplayOSTaserReload&quot;, action, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
&#9;ContextActionService:BindAction(&quot;RoleplayOSTaserSafety&quot;, action, true, Enum.KeyCode.G, Enum.KeyCode.ButtonY)
&#9;ContextActionService:BindAction(&quot;RoleplayOSTaserLight&quot;, action, false, Enum.KeyCode.V)
&#9;ContextActionService:BindAction(&quot;RoleplayOSTaserLaser&quot;, action, false, Enum.KeyCode.L)
&#9;ContextActionService:SetTitle(&quot;RoleplayOSTaserReload&quot;, &quot;RELOAD&quot;)
&#9;ContextActionService:SetTitle(&quot;RoleplayOSTaserSafety&quot;, &quot;SAFE&quot;)
end)

tool.Unequipped:Connect(function()
&#9;stopAnimations()
&#9;for _, name in ipairs({ &quot;RoleplayOSTaserReload&quot;, &quot;RoleplayOSTaserSafety&quot;, &quot;RoleplayOSTaserLight&quot;, &quot;RoleplayOSTaserLaser&quot; }) do
&#9;&#9;ContextActionService:UnbindAction(name)
&#9;end
&#9;if screen then screen:Destroy(); screen = nil end
end)

updateRemote.OnClientEvent:Connect(updateAmmo)

</string>
			</Properties>
		</Item>
	</Item>
