		<Item class="LocalScript" referent="RBXROLEPLAYOSWARRANTCLIENT00000001">
			<Properties>
				<string name="Name">RoleplayOSWarrantCardClient</string>
				<string name="Source">-- Audited replacement for the purchased card's placeholder scripts.
-- Authoritative character name, rank and warrant number are populated by
-- IdentificationService before this tool reaches the player's Backpack.
local Players = game:GetService(&quot;Players&quot;)

local player = Players.LocalPlayer
local tool = script.Parent

local function field(partName: string): TextBox?
&#9;local part = tool:FindFirstChild(partName, true)
&#9;local object = part and part:FindFirstChildWhichIsA(&quot;TextBox&quot;, true)
&#9;return if object and object:IsA(&quot;TextBox&quot;) then object else nil
end

local function secureField(object: TextBox?)
&#9;if not object then return end
&#9;object.TextEditable = false
&#9;object.Active = false
&#9;object.Selectable = false
end

local function refresh()
&#9;local username = field(&quot;Username&quot;)
&#9;local userId = field(&quot;UserNameID&quot;)
&#9;local rank = field(&quot;Rank&quot;)
&#9;secureField(username)
&#9;secureField(userId)
&#9;secureField(rank)
&#9;-- Only replace untouched authoring placeholders. Server-issued selected
&#9;-- character information always wins and is never derived from the client.
&#9;if username and (username.Text == &quot;&quot; or username.Text == &quot;ROBLOX NAME&quot;) then
&#9;&#9;username.Text = player.DisplayName
&#9;end
&#9;if userId and (userId.Text == &quot;&quot; or userId.Text == &quot;1012001367&quot;) then
&#9;&#9;userId.Text = string.format(&quot;UP-%06d&quot;, player.UserId % 1000000)
&#9;end
&#9;if rank and (rank.Text == &quot;&quot; or rank.Text == &quot;FORCE RANK&quot;) then
&#9;&#9;rank.Text = &quot;Police Officer&quot;
&#9;end
&#9;local picture = tool:FindFirstChild(&quot;Picture&quot;, true)
&#9;local portrait = picture and picture:FindFirstChildWhichIsA(&quot;ImageLabel&quot;, true)
&#9;if portrait and portrait:IsA(&quot;ImageLabel&quot;) and portrait.Image == &quot;&quot; then
&#9;&#9;local ok, image = pcall(Players.GetUserThumbnailAsync, Players, player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
&#9;&#9;if ok then portrait.Image = image end
&#9;end
end

tool.Equipped:Connect(refresh)
refresh()</string>
				<bool name="Disabled">false</bool>
