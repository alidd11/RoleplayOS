{
  "name": "RoleplayOS",
  "globIgnorePaths": [
    "**/*.tmp*",
    "**/*.tmp.*",
    "**/.DS_Store",
    "**/*.swp",
    "**/*~"
  ],
  "tree": {
    "Workspace": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "StreamingEnabled": true,
        "StreamingTargetRadius": 1024,
        "StreamingIntegrityMode": "PauseOutsideLoadedArea",
        "ModelStreamingBehavior": "Improved"
      }
    },
    "$className": "DataModel",
    "ReplicatedStorage": {
      "RoleplayOS": {
        "$className": "Folder",
        "Shared": {
          "$path": "src/shared/Utility"
        },
        "Config": {
          "$path": "src/shared/Config"
        },
        "Types": {
          "$path": "src/shared/Types"
        },
        "Network": {
          "$path": "src/shared/Network"
        }
      }
    },
    "ServerScriptService": {
      "RoleplayOS": {
        "$className": "Folder",
        "Services": {
          "$path": "src/server/Services"
        },
        "Systems": {
          "$path": "src/server/Systems"
        },
        "Bootstrap": {
          "$path": "src/server/Bootstrap.server.luau"
        }
      }
    },
    "ServerStorage": {
      "$ignoreUnknownInstances": true,
      "RoleplayOSAssets": {
        "$path": "server-assets"
      },
      "RoleplayOSImportedSources": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "BankRobberySource": {
          "$path": "server-assets/ImportedSources/BankRobberySource.rbxm"
        },
        "PoliceEpaulettesSource": {
          "$path": "server-assets/ImportedSources/PoliceEpaulettesSource.rbxm"
        }
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "RoleplayOSClient": {
          "$path": "src/client"
        }
      }
    }
  }
}
